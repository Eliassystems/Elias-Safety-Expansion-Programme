{"constraint_id":"PC-OVERBROAD-001","policy_failure_class":"PC01","description":"Operative policy scope exceeds the frozen maximum permitted scope.","violation_rule":{"op":"gt","left":{"fact":"actual_scope_count"},"right":{"fact":"max_allowed_scope_count"}}}
